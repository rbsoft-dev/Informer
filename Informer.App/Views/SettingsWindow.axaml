<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Informer.App.ViewModels"
        xmlns:loc="using:Informer.App.Localization"
        x:Class="Informer.App.Views.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        Title="Информер — Настройки"
        Icon="/Assets/tray-icon.ico"
        Width="500" Height="760"
        MinWidth="420" MinHeight="400"
        CanResize="True"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowStartupLocation="Manual">

  <Border Background="{StaticResource FlyoutSurfaceBrush}"
          BorderBrush="{StaticResource FlyoutBorderBrush}" BorderThickness="1"
          CornerRadius="{StaticResource FlyoutCornerRadius}" ClipToBounds="True">
    <Grid RowDefinitions="Auto,*">

      <Border Grid.Row="0" Background="{StaticResource FlyoutHeaderBrush}"
              BorderBrush="{StaticResource FlyoutBorderBrush}" BorderThickness="0,0,0,1"
              PointerPressed="OnHeaderPointerPressed">
        <Grid ColumnDefinitions="*,Auto" Margin="16,10">
          <TextBlock Grid.Column="0" Text="{DynamicResource SettingsTitle}"
                     Foreground="{StaticResource FlyoutTextPrimaryBrush}"
                     FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="✕" Click="OnCloseClick"
                  Background="Transparent" BorderThickness="0"
                  Foreground="{StaticResource FlyoutTextSecondaryBrush}"
                  Padding="8,2" FontSize="14" />
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" Margin="16,16,16,4">
        <StackPanel Spacing="14">
          <Border Background="{StaticResource FlyoutBackgroundBrush}" CornerRadius="8" Padding="14">
          <StackPanel Spacing="10">
            <TextBlock Text="{DynamicResource SectionServerPort}" FontWeight="Bold"
                       Foreground="{StaticResource FlyoutAccentBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{DynamicResource ServerPortLabel}" VerticalAlignment="Center"
                         Foreground="{StaticResource FlyoutTextSecondaryBrush}" />
              <NumericUpDown x:Name="ListenPortInput" Value="{Binding ListenPort}"
                             FormatString="0" Minimum="1" Maximum="65535" Width="125" />
            </StackPanel>
            <TextBlock Text="{DynamicResource ServerPortHint}"
                       Foreground="{StaticResource FlyoutTextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
          <Border Background="{StaticResource FlyoutBackgroundBrush}" CornerRadius="8" Padding="14">
            <StackPanel Spacing="10">
              <TextBlock Text="{DynamicResource SectionLanguage}" FontWeight="Bold"
                         Foreground="{StaticResource FlyoutAccentBrush}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{DynamicResource LanguageLabel}" VerticalAlignment="Center"
                           Foreground="{StaticResource FlyoutTextSecondaryBrush}" />
                <ComboBox ItemsSource="{Binding LanguageOptions}"
                  SelectedItem="{Binding SelectedLanguage}" Width="160">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="loc:LanguageInfo">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource FlyoutBackgroundBrush}" CornerRadius="8" Padding="14">
            <StackPanel Spacing="10">
              <TextBlock Text="{DynamicResource SectionRetention}" FontWeight="Bold"
                         Foreground="{StaticResource FlyoutAccentBrush}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{DynamicResource RetentionLabel}" VerticalAlignment="Center"
                           Foreground="{StaticResource FlyoutTextSecondaryBrush}" />
                <NumericUpDown x:Name="RetentionDaysInput" Value="{Binding RetentionDays}"
                               FormatString="0" Minimum="1" Maximum="365" Width="110" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource FlyoutBackgroundBrush}" CornerRadius="8" Padding="14">
            <StackPanel Spacing="10">
              <TextBlock Text="{DynamicResource SectionSecurity}" FontWeight="Bold"
                         Foreground="{StaticResource FlyoutAccentBrush}" />
              <CheckBox Content="{DynamicResource RequireApiKeyCheckbox}"
                         IsChecked="{Binding RequireApiKey}"
                         Foreground="{StaticResource FlyoutTextPrimaryBrush}" />

              <TextBlock Text="{DynamicResource RateLimitDescription}"
                         Foreground="{StaticResource FlyoutTextSecondaryBrush}" Margin="0,4,0,0" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{DynamicResource RateLimitMaxLabel}" VerticalAlignment="Center"
                           Foreground="{StaticResource FlyoutTextSecondaryBrush}" />
                <NumericUpDown x:Name="RateLimitMaxRequestsInput" Value="{Binding RateLimitMaxRequests}"
                               FormatString="0" Minimum="1" Maximum="10000" Width="108" />
                <TextBlock Text="{DynamicResource RateLimitWindowLabel}" VerticalAlignment="Center"
                           Foreground="{StaticResource FlyoutTextSecondaryBrush}" />
                <NumericUpDown x:Name="RateLimitWindowSecondsInput" Value="{Binding RateLimitWindowSeconds}"
                               FormatString="0" Minimum="1" Maximum="3600" Width="108" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource FlyoutBackgroundBrush}" CornerRadius="8" Padding="14">
            <StackPanel Spacing="10">
              <TextBlock Text="{DynamicResource SectionNotifications}" FontWeight="Bold"
                         Foreground="{StaticResource FlyoutAccentBrush}" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{DynamicResource ToastDurationLabel}" VerticalAlignment="Center"
                           Foreground="{StaticResource FlyoutTextSecondaryBrush}" />
                <NumericUpDown x:Name="ToastDisplaySecondsInput" Value="{Binding ToastDisplaySeconds}"
                               FormatString="0" Minimum="1" Maximum="120" Width="100" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource FlyoutBackgroundBrush}" CornerRadius="8" Padding="14">
            <StackPanel Spacing="10">
              <TextBlock Text="{DynamicResource SectionDisplayPolicy}" FontWeight="Bold"
                         Foreground="{StaticResource FlyoutAccentBrush}" />
              <TextBlock Text="{DynamicResource DisplayPolicyDescription}"
                         Foreground="{StaticResource FlyoutTextSecondaryBrush}" TextWrapping="Wrap" />

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="12" Height="12" CornerRadius="6" Background="{StaticResource FlyoutSuccessBrush}" />
                <CheckBox Content="{DynamicResource ShowInfoCheckbox}" IsChecked="{Binding ShowInfoToasts}"
                           Foreground="{StaticResource FlyoutTextPrimaryBrush}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="12" Height="12" CornerRadius="6" Background="{StaticResource FlyoutWarningBrush}" />
                <CheckBox Content="{DynamicResource ShowWarningCheckbox}" IsChecked="{Binding ShowWarningToasts}"
                           Foreground="{StaticResource FlyoutTextPrimaryBrush}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="12" Height="12" CornerRadius="6" Background="{StaticResource FlyoutDangerBrush}" />
                <CheckBox Content="{DynamicResource ShowErrorCheckbox}" IsChecked="{Binding ShowErrorToasts}"
                           Foreground="{StaticResource FlyoutTextPrimaryBrush}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource FlyoutBackgroundBrush}" CornerRadius="8" Padding="14">
            <StackPanel Spacing="10">
              <TextBlock Text="{DynamicResource SectionApiKeys}" FontWeight="Bold"
                         Foreground="{StaticResource FlyoutAccentBrush}" />

              <ListBox x:Name="ApiKeysList" ItemsSource="{Binding ApiKeys}"
                       MinHeight="0" MaxHeight="160"
                       Background="Transparent"
                       SelectionMode="Single" PointerPressed="OnApiKeysPointerPressed">
                <ListBox.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{DynamicResource CtxCopyKey}" Click="OnCopyKeyClick" />
                    <MenuItem Header="{DynamicResource CtxDeleteKey}" Click="OnDeleteKeyClick" />
                  </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                  <DataTemplate x:CompileBindings="False">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Label}" FontWeight="Bold"
                                   Foreground="{StaticResource FlyoutTextPrimaryBrush}" />
                        <TextBlock Text="{Binding Key}" FontSize="11"
                                   Foreground="{StaticResource FlyoutTextSecondaryBrush}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{DynamicResource ApiKeyActive}" Foreground="{StaticResource FlyoutSuccessBrush}"
                                 IsVisible="{Binding IsActive}" VerticalAlignment="Center" Margin="4,0" />
                      <TextBlock Grid.Column="1" Text="{DynamicResource ApiKeyRevoked}" Foreground="{StaticResource FlyoutDangerBrush}"
                                 IsVisible="{Binding !IsActive}" VerticalAlignment="Center" Margin="4,0" />
                      <Button Grid.Column="2" Content="{DynamicResource RevokeButton}" IsEnabled="{Binding IsActive}"
                              Command="{Binding $parent[ListBox].DataContext.RevokeApiKeyCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox FontSize="13" Watermark="{DynamicResource NewKeyWatermark}"
                          Text="{Binding NewKeyLabel}" Width="320" />
                <Button Content="{DynamicResource AddKeyButton}" Command="{Binding AddApiKeyCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Button Content="{DynamicResource SaveButton}" HorizontalAlignment="Right" Command="{Binding SaveCommand}" />
          <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource FlyoutDangerBrush}"
                   TextWrapping="Wrap" TextAlignment="Right" HorizontalAlignment="Stretch"
                   IsVisible="{Binding IsStatusError}" />
          <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource FlyoutSuccessBrush}"
                   TextWrapping="Wrap" TextAlignment="Right" HorizontalAlignment="Stretch"
                   IsVisible="{Binding !IsStatusError}" />
           <Border Height="12" />
        </StackPanel>
      </ScrollViewer>
        <Border Width="6" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeWestEast" Tag="West" PointerPressed="OnResizeGripPressed" />
        <Border Width="6" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWestEast" Tag="East" PointerPressed="OnResizeGripPressed" />
        <Border Height="6" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNorthSouth" Tag="North" PointerPressed="OnResizeGripPressed" />
        <Border Height="6" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNorthSouth" Tag="South" PointerPressed="OnResizeGripPressed" />
        <Border Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="TopLeftCorner" Tag="NorthWest" PointerPressed="OnResizeGripPressed" />
        <Border Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="TopRightCorner" Tag="NorthEast" PointerPressed="OnResizeGripPressed" />
        <Border Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomLeftCorner" Tag="SouthWest" PointerPressed="OnResizeGripPressed" />
        <Border Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomRightCorner" Tag="SouthEast" PointerPressed="OnResizeGripPressed" />
    </Grid>
  </Border>

</Window>